
 def geninv(self, G, type='pinv', getmodres='Null'):

        N = G.shape[0]
        M = G.shape[1]

        if type == 'pinv':

            # Penrose pseudoinverse
            Gig=np.linalg.pinv(G)

        elif type == 'tsvd':

            # Truncated SVD with L-curve
            U, S, VT = np.linalg.svd(G)
            V = VT.T

            print("TSVD S=",S)

            popt = self.getpopt(S)
            Up = U[:, range(0, popt)]
            Vp = V[:, range(0, popt)]
            Sp = S[range(0, popt)]
            iSp = np.diag(1. / Sp)
            Gig = np.dot(np.dot(Vp, iSp), Up.T)


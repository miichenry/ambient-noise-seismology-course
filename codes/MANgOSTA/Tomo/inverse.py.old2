
import numpy as np
from copy import deepcopy

class Inverse:

    def __init__(self, params):

        self.theta=params['regul']

    def settickhonov(self, L):
        self.L = deepcopy(L)
        self.LL = np.dot(L.T,L)

    def getLcurve_sel(self, lm, ld):

        llm = np.log(lm)
        lld = np.log(ld)
        llm = (llm - np.min(llm)) / (np.max(llm) - np.min(llm))
        lld = (lld - np.min(lld)) / (np.max(lld) - np.min(lld))

        curv1 = np.full(llm.shape, fill_value=-1.)
        for i in range(1, len(lld) - 1):
            v1 = np.array([lld[i-1] - lld[i], llm[i-1] - llm[i], 0])
            v1 = v1 / np.linalg.norm(v1)
            v2 = np.array([lld[i+1] - lld[i], llm[i+1] - llm[i], 0])
            v2 = v2 / np.linalg.norm(v2)
            v3 = np.cross(v1, v2)
            v4 = np.dot(v1,v2)
            #print(i,v1,v2,v4)
            if v3[2]<0: v4=-1
            curv1[i]=v4

        curv1[np.isnan(curv1)]=-1

        #idx = np.argmax(curv1)
        #print("idx=",idx, curv1[idx])

        # Check all the relative maxima
        idx=[]
        for i in range(1,len(curv1)-1):
            if curv1[i]>curv1[i-1] and curv1[i]>curv1[i+1]:
                #print("Rel. maxim ",i)
                idx.append(i)

        if idx==[]: idx=np.argmax(curv1)
        else: idx=idx[0]

        #print("maximo ",idx, flush=True)

        import matplotlib.pyplot as plt

        fig = plt.figure(constrained_layout=True)
        gs = fig.add_gridspec(5, 1)

        ax = fig.add_subplot(gs[0, 0])
        ax.plot(curv1, 'k')
        ax.plot(idx, curv1[idx], 'ro')
        ax.set_title('curv')

        ax = fig.add_subplot(gs[1, 0])
        ax.plot(lld, 'k')
        ax.plot(idx, lld[idx], 'ro')
        ax.set_title('lld')

        ax = fig.add_subplot(gs[2, 0])
        ax.plot(llm, 'k')
        ax.plot(idx, llm[idx], 'ro')
        ax.set_title('llm')

        ax = fig.add_subplot(gs[3:, 0])
        ax.plot(lld, llm, 'ko')
        ax.plot(lld[0], llm[0], 'bo')
        ax.plot(lld[idx], llm[idx], 'ro')

        plt.show()

        return idx

    def tsvd(self, G, m0, res, valid, inv):

        print("TSVD")

        # Truncated SVD
        U, S, VT = np.linalg.svd(G)
        V = VT.T

        maxp=len(S)

        if maxp>1:

            lm = []
            ld = []
            lp = []
            gcv = []
            for p in range(1,maxp+1):

                Sp = S[range(0, p)]
                if Sp[-1]/Sp[0]<1e-10: break

                Up = U[:, range(0, p)]
                Vp = V[:, range(0, p)]
                iSp = np.diag(1. / Sp)
                Gig = np.dot(np.dot(Vp, iSp), Up.T)
                dm = np.dot(Gig,res)
                sy = np.dot(G,dm)

                m1 = m0 - dm
                if not valid(m1): break


                lm.append(np.linalg.norm(dm))
                ld.append(np.linalg.norm(res-sy))
                lp.append(p)

                A = np.dot(G, Gig)
                tr = np.sum(1. - np.diag(A)) ** 2
                gcv.append(np.linalg.norm(res-sy) ** 2 / tr)

            if lp==[]:
                return None, False

            idx = self.getLcurve_sel(lm,ld)
            popt = lp[idx]

        else:
            popt=1

        print("popt=",popt)
        Up = U[:, range(0, popt)]
        Vp = V[:, range(0, popt)]
        Sp = S[range(0, popt)]
        iSp = np.diag(1. / Sp)
        Gig = np.dot(np.dot(Vp, iSp), Up.T)

        dm = -np.dot(Gig, res)

        return dm, True

    def tik0(self, G, m0, res, valid, inv, mref):

        print("Tikhonov (zeroth order) regularization")

        M = G.shape[1]

        eps2r = np.flipud(np.logspace(-5, 10, 100))

        G1=np.dot(G.T,G)

        ####################
        lm = []
        ld = []
        leps = []
        for i in range(len(eps2r)):

            G2 = G1 + eps2r[i] * np.eye(M)

            if inv=='LINEAR':
                Gig = np.dot(np.linalg.inv(G2),G.T)
                dm = np.dot(Gig, res)

            else:
                G3 = np.linalg.inv(G2)
                G4 = np.dot(G.T,res) + eps2r[i] * (m0-mref)
                dm = np.dot(G3, G4)

            sy = np.dot(G, dm)
            m1 = m0 - dm
            if not valid(m1): break

            if inv=='LINEAR':
                lm.append(np.linalg.norm(dm))
            else:
                lm.append(np.linalg.norm(m1-mref))
            ld.append(np.linalg.norm(res-sy))
            leps.append(eps2r[i])

        idx = self.getLcurve_sel(lm, ld)
        eps2 = eps2r[idx]
        print("best eps2=%g" % eps2)

        G2 = G1 + eps2 * np.eye(M)

        if inv == 'LINEAR':
            Gig = np.dot(np.linalg.inv(G2), G.T)
            dm = np.dot(Gig, res)

        else:
            G3 = np.linalg.inv(G2)
            G4 = np.dot(G.T, res) + eps2 * (m0-mref)
            dm = np.dot(G3, G4)

        return -dm, True

    def tik2(self, G, m0, res, valid, inv, mref):

        print("Tikhonov (second order) regularization")

        eps2r=np.flipud(np.logspace(-5,20,100))

        G1=np.dot(G.T,G)

        import matplotlib.pyplot as plt

        #print("L")
        #print(self.L)

        if self.L.shape[0]>1:
            plt.pcolor(self.L)
            plt.colorbar()
            plt.show()

            #print("LL")
            #print(self.LL.shape)
            #print(self.LL)
            plt.pcolor(self.LL)
            plt.colorbar()
            plt.show()

        lm = []
        ld = []
        leps = []
        for i in range(len(eps2r)):

            G2 = G1 + eps2r[i] * self.LL

            if inv=='LINEAR':
                Gig = np.dot(np.linalg.inv(G2),G.T)
                dm = np.dot(Gig, res)

            else:
                G3 = np.linalg.inv(G2)
                G4 = np.dot(G.T,res) + eps2r[i] * np.dot(self.LL.T,np.dot(self.LL,m0))
                dm = np.dot(G3, G4)

            m1 = m0 - dm
            if not valid(m1): break

            sy = np.dot(G, dm)

            lm.append(np.linalg.norm(dm))
            ld.append(np.linalg.norm(res-sy))
            leps.append(eps2r[i])

        if leps == []:
            print("TIK2 leps=[]")
            return None, False

        idx = self.getLcurve_sel(lm, ld)
        eps2 = eps2r[idx]
        print("best eps2=", eps2)

        G2 = G1 + eps2 * self.LL

        if inv == 'LINEAR':
            Gig = np.dot(np.linalg.inv(G2), G.T)
            dm = np.dot(Gig, res)

        else:
            G3 = np.linalg.inv(G2)
            G4 = np.dot(G.T, res) + eps2 * np.dot(self.LL.T, np.dot(self.LL, m0))
            dm = np.dot(G3, G4)

        return -dm, True

    def getinverse(self, G, m0, res, valid=None, inv='LINEAR', ref=None):

            deltam, flag = self.tsvd(G, m0, res, valid, inv)

        elif self.type == "TIK0":
            deltam, flag = self.tik0(G, m0, res, valid, inv, ref)

        elif self.type == "TIK2":
            deltam, flag = self.tik2(G, m0, res, valid, inv, ref)

        else:
            print("Wrong inversione type:",self.type)
            exit(1)

        return deltam, flag
